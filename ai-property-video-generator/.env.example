# ============================================================================
# AI Property Video Generator - environment template
# Copy to ".env" and fill in only what you need. NEVER commit the real .env.
# Everything here is OPTIONAL: the app runs fully without an API key by using
# the template script generator, Edge TTS (free/keyless) or Windows SAPI.
# ============================================================================

# --- Server -----------------------------------------------------------------
# Bind address. Keep 127.0.0.1 for local use. A container/proxy deployment uses
# waitress instead (see Dockerfile), so APP_HOST is only for `python app.py`.
APP_HOST=127.0.0.1
APP_PORT=5000

# --- Deployment (optional) ---------------------------------------------------
# Set BOTH to enable HTTP Basic authentication. Without them, only loopback
# clients are accepted. Always serve a public deployment over HTTPS.
APP_USERNAME=
APP_PASSWORD=
# Set to 1 behind a reverse proxy that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=0
# Set to 1 when the browser reaches the app over HTTPS (secure session cookie).
APP_HTTPS=0

# Flask session/CSRF signing key. Leave blank and the app generates one into
# config/session.key on first run. Set an explicit long random value for a
# reproducible deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-string

# --- LLM script generation (optional) ---------------------------------------
# Provider: "gemini" or "openai_compatible"
LLM_PROVIDER=gemini
# Google AI Studio key (https://aistudio.google.com/apikey). Placeholder only.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# For OpenAI / Z.ai / Groq / OpenRouter / local Ollama, set provider above to
# "openai_compatible" and fill these in. Local Ollama needs no key.
OPENAI_COMPAT_API_KEY=your-openai-compatible-key-here
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini

# Disable AI entirely and always use the deterministic template script.
FORCE_TEMPLATE_SCRIPT=0

# --- Voice-over (optional; Edge + Windows SAPI need no key) ------------------
# Primary engine: edge | windows_sapi | openai | elevenlabs
TTS_ENGINE=edge
# Optional explicit fallback engine (surfaced in the UI when used). "none" = off.
TTS_FALLBACK_ENGINE=windows_sapi

OPENAI_TTS_API_KEY=your-openai-key-here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Media tools ------------------------------------------------------------
# Optional: point at a specific FFmpeg binary. If unset the app uses ffmpeg on
# PATH, then the bundled imageio-ffmpeg build (recommended on Windows).
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe
